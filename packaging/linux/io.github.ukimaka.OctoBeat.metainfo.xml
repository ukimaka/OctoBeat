<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ukimaka.OctoBeat</id>
  <name>OctoBeat</name>
  <summary>Play and manage your local music library</summary>
  <developer id="io.github.ukimaka">
    <name>ukimaka</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      OctoBeat is a local music player with YouTube search, downloads,
      playlists, cover art, lyrics, a native Rust audio engine and MPRIS
      media-key integration.
    </p>
    <p>
      It keeps the familiar OctoBeat visual style and database format while
      using a Rust core and Qt 6 Widgets interface.
    </p>
  </description>

  <launchable type="desktop-id">io.github.ukimaka.OctoBeat.desktop</launchable>
  <url type="homepage">https://github.com/ukimaka/OctoBeat</url>
  <url type="bugtracker">https://github.com/ukimaka/OctoBeat/issues</url>
  <url type="vcs-browser">https://github.com/ukimaka/OctoBeat</url>

  <screenshots>
