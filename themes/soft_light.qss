/* @accent: #5151ab */
* {
    color: #2E3440;
    font-family: sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget, QDialog {
    background-color: #F4F6F8;
}

QTabWidget::pane {
    border: none;
    background-color: #F4F6F8;
    margin-top: 0px;
}

/* Панели: лёгкий вертикальный градиент вместо плоского цвета. */
#customTitleBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F4F6F8);
    border-bottom: 1px solid #E5E7EB;
}

#playerBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #F4F6F8);
    border-top: 1px solid #E5E7EB;
}

QTabBar::tab {
    background: transparent;
    color: #6B7280;
    padding: 0px 14px;
    min-height: 38px;
    border: none; /* Убирает белые полосы */
}

QTabBar::tab:selected {
    color: #2E3440;
    border-top: 2px solid #5151ab; /* Наш фирменный цвет */
}

QTabBar::tab:hover {
    background: #E5E7EB;
}

QListWidget {
    background-color: #FFFFFF;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border: none;
    outline: none;
}

QListWidget::item:hover {
    background-color: #E5E7EB;
}

QListWidget::item:selected {
    background-color: rgba(81, 81, 171, 0.4);
    color: #2E3440;
    border: none;
}

QTreeView, QTreeWidget {
    outline: none;
    border: none;
    show-decoration-selected: 0;
}

QTreeView::item:focus, QTreeView::item:selected, QTreeView::item:hover {
    outline: none;
    border: none;
}

QTreeView::item:selected, QTreeView::item:focus,
QTreeWidget::item:selected, QListView::item:selected {
    background: transparent;
    outline: none;
    border: none;
    selection-background-color: transparent;
    selection-color: inherit;
}

QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    color: #2E3440;
}

/* Справа нужен запас под drop-down и стрелку сортировки. */
QComboBox {
    padding: 4px 30px 4px 8px;
}

QLineEdit:focus, QComboBox:focus {
    background-color: #f2f3f4;
}

QLineEdit:hover, QComboBox:hover {
    border: 1px solid #5151ab;
}

QWidget#playlistDetail {
    background: transparent;
}

QTextEdit#playlistDescription {
    background: transparent;
    border: none;
    color: #2E3440;
    font-size: 13px;
    padding: 0;
}

QTextEdit#playlistDescription:focus {
    background: transparent;
    border: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url("@ICONS_DIR@/black/chevron-down.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: none;
    outline: none;
    padding: 4px;
    selection-background-color: #E5E7EB;
    selection-color: #2E3440;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
}

QPushButton {
    background: transparent;
    border: none;
    padding: 4px;
}

QPushButton:hover {
    background: #E5E7EB;
    border-radius: 6px;
}

QLabel {
    background: transparent;
}

QMenu {
    background-color: #FFFFFF;
    color: #2E3440;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 24px;
    background: transparent;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #E5E7EB;
}

QMenu::separator {
    height: 1px;
    background: #E5E7EB;
    margin: 4px 8px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: transparent;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #5151ab;
    border-radius: 2px;
    height: 4px;
}

QSlider::add-page:horizontal {
    background: #E5E7EB;
    border-radius: 2px;
    height: 4px;
}

QSlider::handle:horizontal {
    background: #2E3440;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #5151ab;
    width: 14px;
    margin: -6px 0;
}

QProgressDialog {
    background-color: #F4F6F8;
}

QScrollBar:vertical {
    background: #F4F6F8;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #E5E7EB;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    background-color: #E5E7EB;
    color: #2E3440;
    border: 1px solid #5151ab;
    padding: 4px;
    border-radius: 4px;
}

QLabel#currentTrack {
    color: #2E3440;
}

QLabel#contextLabel {
    color: #6B7280;
}

QWidget#nextTrackIsland {
    background-color: #E5E7EB;
    border-radius: 8px;
}

QLabel#nextTrackCaption {
    color: #6B7280;
    font-size: 11px;
}

QLabel#nextTrackTitle {
    color: #2E3440;
    font-size: 12px;
    font-weight: 600;
}

QLabel#nextTrackArtist {
    color: #6B7280;
    font-size: 11px;
}

QTextBrowser#lyricsView {
    background: transparent;
    border: none;
    color: #6B7280;
    padding: 6px 14px;
}

QScrollBar#profileScrollBar:vertical {
    background: #F4F6F8;
    width: 6px;
    margin: 2px 0;
}

QScrollBar#profileScrollBar::handle:vertical {
    background: #E5E7EB;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar#profileScrollBar::handle:vertical:hover {
    background: #5151ab;
}

QScrollBar#profileScrollBar::add-line:vertical,
QScrollBar#profileScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar#profileScrollBar::add-page:vertical,
QScrollBar#profileScrollBar::sub-page:vertical {
    background: transparent;
}

QFileDialog {
    background-color: #F4F6F8;
    border: none;
}

QFileDialog QPushButton {
    background-color: #f2f3f4;
    color: #2E3440;
    border: 1px solid #dedfe0;
    border-radius: 6px;
    padding: 6px 16px;
}

QFileDialog QPushButton:hover {
    background-color: #dedfe0;
    border-color: #5151ab;
}

QFileDialog QPushButton:pressed {
    background-color: #5151ab;
}

QFileDialog QPushButton:disabled {
    background-color: #FFFFFF;
    color: #6B7280;
    border-color: #dedfe0;
}

QFileDialog QLineEdit,
QFileDialog QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #dedfe0;
    border-radius: 6px;
    padding: 6px 8px;
    color: #2E3440;
}

QFileDialog QLineEdit:focus,
QFileDialog QComboBox:focus {
    border: 1px solid #5151ab;
}

QFileDialog QComboBox::drop-down {
    border: none;
    width: 24px;
}

QFileDialog QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #dedfe0;
    color: #2E3440;
    outline: none;
    selection-background-color: #5151ab;
    selection-color: #2E3440;
}

QFileDialog QTreeView,
QFileDialog QListView {
    background-color: #FFFFFF;
    border: 1px solid #dedfe0;
    border-radius: 6px;
    color: #2E3440;
    outline: none;
}

QFileDialog QTreeView::item,
QFileDialog QListView::item {
    padding: 4px 6px;
    border: none;
}

QFileDialog QTreeView::item:selected,
QFileDialog QListView::item:selected {
    background-color: #5151ab;
    color: #2E3440;
}

QFileDialog QTreeView::item:hover,
QFileDialog QListView::item:hover {
    background-color: #E5E7EB;
}

QFileDialog QHeaderView::section {
    background-color: #f2f3f4;
    color: #2E3440;
    border: none;
    border-bottom: 1px solid #dedfe0;
    padding: 4px 6px;
}

QFileDialog QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QFileDialog QToolButton:hover {
    background: #E5E7EB;
}

QFileDialog QSplitter::handle {
    background-color: #dedfe0;
}

QFileDialog QLabel {
    background: transparent;
    color: #2E3440;
}

QDialog, QWidget, QMenu {
    outline: none;
}

QFocusFrame {
    border: none;
    background: transparent;
}

/* ===== SETTINGS NAVIGATION (soft_light) ===== */
QListWidget#settingsNav {
    background-color: #f5f5f5;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}
QListWidget#settingsNav::item {
    color: #555555;
    padding: 9px 14px;
    border-radius: 6px;
}
QListWidget#settingsNav::item:hover {
    color: #000000;
    background-color: rgba(0, 0, 0, 0.08);
}
QListWidget#settingsNav::item:selected {
    background-color: #5151ab;
    color: #ffffff;
}
